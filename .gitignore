# Node
app/node_modules/
app/package-lock.json

# Machine-local overrides + secrets (start.gg token). Never commit.
app/config.local.js

# Combo clipper tunables written by the control panel — per-machine (OBS
# password, replay folder) and retuned per venue, so it never belongs in git.
app/clipper-settings.json
app/clipper-settings.json.tmp

# Players' start.gg set histories, saved by the side panel's stats so a regular
# is crawled once rather than every time they're on stream. Rebuilt on demand.
app/stats-cache/

# Per-machine runtime state: the live scoreboard (saved on every change so a
# restart mid-set restores it) and, by default, the player DB
# (local_players.json — this machine's players, never the repo's). The
# *.example.json samples are the exception: they document the format.
app/data/*
!app/data/*.example.json

# An old TSH install left in or beside the repo. The app doesn't use it (the rollback is the tsh-final tag);
# the whole folder stays untracked (it is ~4000 vendored files and its own
# user_data/ with a real player DB).
TournamentStreamHelper-*/

# Python bytecode from the OBS scripts (OBS compiles them on load)
__pycache__/
*.pyc

# Claude local files
.claude/

# The stats popup's art packs, downloaded from the dock's Setup tab (~280 MB;
# lib/set-stats/art-packs.js). Not committed, a clone downloads its own, except
# the VS screen pack (full): committed upscaled 2x, since the release's copy is
# too low-res for the popup. Its .installed.json is per machine.
overlays/assets/packs/*
!overlays/assets/packs/full/
overlays/assets/packs/full/.installed.json

# Local scratch: render comparisons and other throwaway artefacts.
.scratch/

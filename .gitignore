# Node
slippi-bridge/node_modules/
slippi-bridge/package-lock.json

# Machine-local overrides + secrets (start.gg token). Never commit.
slippi-bridge/config.local.js

# Combo clipper tunables written by the control panel — per-machine (OBS
# password, replay folder) and retuned per venue, so it never belongs in git.
slippi-bridge/clipper-settings.json
slippi-bridge/clipper-settings.json.tmp

# Players' start.gg set histories, saved by the side panel's stats so a regular
# is crawled once rather than every time they're on stream. Rebuilt on demand.
slippi-bridge/stats-cache/

# The live scoreboard (set, names, score, per-game list), saved on every change
# so a restart mid-set restores it. Per-machine runtime state.
slippi-bridge/data/

# Exclude all of the third-party TSH app, but keep our custom layout.
# Version-independent so a TSH update (new TournamentStreamHelper-X.YYY folder)
# doesn't silently start tracking the whole vendored Python app.
TournamentStreamHelper-*/*
!TournamentStreamHelper-*/layout/

# Python bytecode from the OBS scripts (OBS compiles them on load)
__pycache__/
*.pyc

# Claude local files
.claude/

# Local scratch: render comparisons and other throwaway artefacts.
.scratch/
